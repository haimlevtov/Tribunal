# Copy to .env.local and fill in. Never commit .env.local.
# None of these may be prefixed NEXT_PUBLIC_ — they must stay server-side.

# https://openrouter.ai/keys — a free account is enough; the default roster is all $0 models.
OPENROUTER_API_KEY=sk-or-v1-...

# Supabase → Project Settings → API
SUPABASE_URL=https://pbxfspcfrsunscglejfn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional. Off by default: the whole run uses $0 models.
# Set true only if you want automatic paid fallback when free models are rate-limited.
ALLOW_PAID_FALLBACK=false

# Hard ceiling on cumulative paid spend, in USD. Only consulted when paid fallback is on.
MAX_TOTAL_SPEND_USD=5.00

# Optional shared passphrase. If set, the charge sheet form requires it before starting a run.
# Leave unset for an open demo.
TRIBUNAL_ACCESS_CODE=
