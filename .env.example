# Copy to .env.local and fill in. Never commit .env.local.
# None of these may be prefixed NEXT_PUBLIC_ — they must stay server-side.

# https://openrouter.ai/keys — the default roster is still all $0 models, but the
# paid fallback below needs credits on the account to be usable.
OPENROUTER_API_KEY=sk-or-v1-...

# Supabase → Project Settings → API
SUPABASE_URL=https://pbxfspcfrsunscglejfn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Paid models. ON unless this is set to exactly "false".
# A default run still costs $0 — free models are tried first and the paid roster
# is the cheapest-first last resort — but a seat is no longer lost to a
# rate-limited free endpoint, and a paid model can be chosen deliberately.
ALLOW_PAID_FALLBACK=true

# Hard ceiling on cumulative paid spend, in USD, across every run ever. Checked
# against the ledger before each paid attempt, so it survives redeploys and
# concurrent invocations. A whole tribunal costs well under a cent, so $5 is
# hundreds of runs.
MAX_TOTAL_SPEND_USD=5.00

# Per-run ceiling, so one runaway tribunal cannot eat the whole allowance.
MAX_RUN_SPEND_USD=0.05

# Optional shared passphrase. If set, the charge sheet form requires it before
# starting a run. Strongly recommended now that runs can spend: a deployed URL is
# public, and this is what stops a passing crawler drawing on the allowance.
TRIBUNAL_ACCESS_CODE=
